# =============================
# Fixora Azure Bootstrap (Minimal)
# Fill only the REQUIRED values below.
# The rest can be generated by setup scripts.
# =============================

# ----- REQUIRED: Azure auth -----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ----- REQUIRED: deployment scope -----
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# ----- REQUIRED: execution target choice -----
# Supported values: aci | containerapps
AZURE_EXECUTION_MODE=aci

# Enable Azure sandbox execution in backend
USE_AZURE_SANDBOX=true

# =============================
# Optional (auto-generated if empty)
# =============================

# Naming prefix used by bootstrap scripts (example: fixora)
AZURE_NAME_PREFIX=fixora

# If blank, scripts can create/generate these:
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=jobs
AZURE_ACR_NAME=
AZURE_LOG_ANALYTICS_WORKSPACE=
AZURE_CONTAINER_IMAGE=

# Optional network hardening
AZURE_VNET_NAME=
AZURE_SUBNET_NAME=

# Optional runtime tuning for ACI
AZURE_ACI_CPU=2
AZURE_ACI_MEMORY_GB=4
AZURE_ACI_TIMEOUT_SECONDS=900

